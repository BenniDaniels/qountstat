Package: qountstat
Type: Package
Title: Statistical Analysis of Count Data and Quantal Data
Version: 0.2.0
Authors@R: c(
    	person("Benjamin", "Daniels", comment = c(ORCID = "0000-0002-8344-6141"),  email = "benjamin.daniels@rwth-aachen.de", role = c("cre", "aut"),),
	person("Christian", "Dietrich", role = "aut"),
